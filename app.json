        "foregroundImage": "./assets/logo_lucrocerto.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "supabaseUrl": "https://oshesvkmupssuivhpntd.supabase.co",
      "supabaseAnonKey": "sb_publishable_ewpiWouTZfUXYWwavUCUqQ_pA4NFVyY",
      "eas": {
        "projectId": "f6f01b2e-da00-4d8e-80b2-ab6677359826"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permita que o $(PRODUCT_NAME) acesse a câmera para ler códigos de barras."
        }
      ],
